{
  "name": "shirazen-time-tracker",
  "displayName": "Shirazen Time Tracker",
  "description": "Reliable VS Code time tracking with pause/resume, persistent timers, summaries, and professional Excel reports",
  "version": "0.1.0",
  "publisher": "javad-hasani",
  "repository": {
    "type": "git",
    "url": "https://github.com/javad-hasani/shirazen-time-tracker.git"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": ["Other"],
  "keywords": ["time-tracking", "productivity", "work-logger", "time-management", "excel"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "shirazen.startTimer", "title": "Shirazen: Start Timer", "icon": "$(play-circle)" },
      { "command": "shirazen.pauseResumeTimer", "title": "Shirazen: Pause/Resume Timer", "icon": "$(debug-pause)" },
      { "command": "shirazen.saveAndResetTimer", "title": "Shirazen: Save Session and Continue", "icon": "$(save)" },
      { "command": "shirazen.stopTimer", "title": "Shirazen: Stop Timer", "icon": "$(debug-stop)" },
      { "command": "shirazen.resetTimer", "title": "Shirazen: Reset Timer", "icon": "$(discard)" },
      { "command": "shirazen.showTodaySummary", "title": "Shirazen: Show Today's Summary", "icon": "$(graph)" },
      { "command": "shirazen.openFolder", "title": "Shirazen: Open Time Logs Folder", "icon": "$(folder-opened)" }
    ],
    "configuration": {
      "title": "Shirazen Time Tracker",
      "properties": {
        "shirazenTimeTracker.defaultProject": {
          "type": "string",
          "default": "",
          "description": "Project name used in reports. Leave empty to use the current workspace name."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && mocha \"out/test/**/*.test.js\""
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^14.18.63",
    "@types/vscode": "^1.60.0",
    "mocha": "^10.4.0",
    "typescript": "^4.9.5"
  }
}
